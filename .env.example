# ==============================================================================
# PJP Sales Optimization Copilot — Environment Configuration
# ==============================================================================
#
# NOTE: The dashboard and GraphRAG engine operate 100% out-of-the-box in zero-config
# mode using the pre-indexed JSON Knowledge Graph snapshot bundle.
# All environment variables below are OPTIONAL.
#
# ------------------------------------------------------------------------------
# 1. OpenRouter LLM Synthesis (Optional)
# ------------------------------------------------------------------------------
# Set this to enable live generative natural language reasoning via Claude 3.5 Sonnet / Gemini.
# If omitted or empty, the deterministic GraphRAG synthesis engine handles 100% of queries
# with zero external API dependencies and zero hallucination risk.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# ------------------------------------------------------------------------------
# 2. Remote Neo4j AuraDB / Self-Hosted Graph Database (Optional)
# ------------------------------------------------------------------------------
# By default, the application queries the embedded snapshot in web/data/pjp_graph_snapshot.json.
# If you have a live Neo4j AuraDB instance, enter connection details below:
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

